# PostgreSQL connection strings. The test database is wiped on every `npm test`.
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/regear"
TEST_DATABASE_URL="postgresql://postgres:<password>@localhost:5432/regear_test"

# Public origin of the site (used for canonical URLs, sitemap, CSRF origin checks)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Where uploaded images and private verification documents are stored
STORAGE_DIR="./storage"

# Optional: keep uploaded images in Supabase Storage instead of STORAGE_DIR
# (needed on hosts without a lasting disk, such as Vercel). Set both or neither.
# Project Settings -> API: the Project URL, and the service_role / secret key.
# The key has full access to the project: server-side only, never NEXT_PUBLIC_.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Secret for the maintenance cron endpoint (POST /api/cron/maintenance). >= 32 chars.
CRON_SECRET="change-me-to-a-long-random-string-of-32-plus-chars"

# Outgoing email (verification, password reset, order updates) over SMTP. Works with any
# provider (Brevo, Mailgun, Amazon SES, Resend, ...). Leave empty in development: emails are
# then written to STORAGE_DIR/dev-mail and listed at http://localhost:3000/api/dev/mail.
SMTP_URL=""
EMAIL_FROM="ReGear <no-reply@your-domain>"

# Set to "true" only when running behind a reverse proxy that sets X-Forwarded-For.
# Production should always run behind one: otherwise every visitor shares one rate limit.
TRUST_PROXY="false"
# Number of proxies in front of the app (e.g. 2 for CDN -> load balancer). The client IP
# is read that many entries from the right of X-Forwarded-For; entries further left are
# written by the client and are ignored.
TRUST_PROXY_HOPS="1"

# Midtrans payments. Leave the key empty for simulated payments in development
# (production refuses to take payments without one). Sandbox keys start with "SB-".
# Notification URL in the Midtrans dashboard: https://<your site>/api/payments/midtrans
MIDTRANS_SERVER_KEY=""
MIDTRANS_ENV="sandbox"

# Seller withdrawals are paid by hand in production: an admin transfers the money and
# marks it paid. "manual" does the same locally; "auto" simulates the transfer in development.
PAYOUTS_MODE="auto"

# Google sign-in (OAuth 2.0 / OpenID Connect). Leave empty to hide the button.
# Authorized redirect URI to register in Google Cloud: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
